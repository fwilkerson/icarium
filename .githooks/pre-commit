#!/usr/bin/env bash
# Reject commits that would fail format or lint. Checks the *staged*
# content (not the working tree) so unstaged edits cannot bypass it.
# Does NOT auto-rewrite — diffs stay predictable for the operator.
set -euo pipefail

files=$(git diff --cached --name-only --diff-filter=ACM -- '*.hs')
[ -z "$files" ] && exit 0

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fail=0
while IFS= read -r f; do
    git show ":$f" > "$tmp/staged.hs"
    ./bin/stylish-haskell < "$tmp/staged.hs" > "$tmp/formatted.hs"
    if ! cmp -s "$tmp/staged.hs" "$tmp/formatted.hs"; then
        echo "stylish-haskell would change $f; run \`make format\` and re-stage." >&2
        fail=1
    fi
done <<< "$files"
[ "$fail" -eq 0 ] || exit 1

# hlint on the working-tree files. Edge case: if unstaged edits fix
# violations that exist in the staged content, this passes while the
# actual commit content would fail. Re-staging converges.
hlint $files
