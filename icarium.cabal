cabal-version:      3.0
name:               icarium
version:            0.6.0
synopsis:           Task/context/dispatch tool for headless-agent workflows
author:             frank
maintainer:         frank.w1lk3rs0n@gmail.com
build-type:         Simple
extra-source-files: spec/schema.sql
                    spec/migrations/*.sql

common lang
    default-language:   GHC2021
    default-extensions: OverloadedStrings
                        LambdaCase
                        StrictData
                        RecordWildCards
    ghc-options:        -Wall -Wunused-packages

library
    import:           lang
    hs-source-dirs:   src
    exposed-modules:  Icarium.Types
                      Icarium.Id
                      Icarium.Schema
                      Icarium.Migrations
                      Icarium.Db
                      Icarium.Config
                      Icarium.Render
                      Icarium.Git
                      Icarium.Dispatch
                      Icarium.Dispatch.Internal
                      Icarium.Dispatch.Agreement
                      Icarium.Dispatch.Claude
                      Icarium.Dispatch.LogResult
                      Icarium.Dispatch.Merge
                      Icarium.Dispatch.PostClaude
                      Icarium.Dispatch.Outcome
                      Icarium.Dispatch.Reviewer
                      Icarium.Dispatch.Tick
                      Icarium.Dispatch.Worktree
                      Icarium.Heartbeat
                      Icarium.Node
                      Icarium.Repo.Internal
                      Icarium.Repo.Task
                      Icarium.Repo.Context
                      Icarium.Repo.Edge
                      Icarium.Repo.Category
                      Icarium.Repo.Dispatch
                      Icarium.Repo.Search
                      Icarium.Repo.Fts
                      Icarium.Time
                      Icarium.Bodies
                      Icarium.Bodies.Sweep
                      Icarium.Commands.Util
                      Icarium.Commands.Init
                      Icarium.Commands.Doctor
                      Icarium.Commands.Task
                      Icarium.Commands.Ctx
                      Icarium.Commands.Link
                      Icarium.Commands.Category
                      Icarium.Commands.Dispatch
                      Icarium.Commands.Search
                      Icarium.Commands.Reindex
                      Icarium.Commands.Agents
    build-depends:    base          >= 4.18 && < 5,
                      text,
                      bytestring,
                      aeson,
                      sqlite-simple,
                      direct-sqlite,
                      file-embed,
                      directory,
                      filepath,
                      ulid,
                      optparse-applicative,
                      tomland,
                      transformers,
                      typed-process,
                      time,
                      unix

executable icarium
    import:           lang
    hs-source-dirs:   app
    main-is:          Main.hs
    autogen-modules:  Paths_icarium
    other-modules:    Paths_icarium
    build-depends:    base,
                      icarium,
                      optparse-applicative

test-suite icarium-test
    import:           lang
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    ghc-options:      -threaded -with-rtsopts=-N
    other-modules:    BodiesSpec
                      CliSpec
                      GitSpec
                      GuardSpec
                      HeartbeatSpec
                      LogResultSpec
                      NodeSpec
                      PostClaudeSpec
                      RenderSpec
                      RepoSpec
                      ReviewerSpec
                      TestHelpers
                      TickSpec
                      TimeoutSpec
    build-depends:    base,
                      bytestring,
                      directory,
                      filepath,
                      text,
                      time,
                      sqlite-simple,
                      icarium,
                      tasty,
                      tasty-hunit,
                      temporary,
                      typed-process
