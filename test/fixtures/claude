#!/bin/sh
# Stub `claude` for icarium's CLI integration tests.
#
# The dispatcher runs this with cwd = the dispatch worktree and with
# ICARIUM_TASK_ID / ICARIUM_DB set in the environment. Behaviour is chosen
# by STUB_CLAUDE_MODE (default: commit). We consume the prompt on stdin and
# emit the init + result stream-json lines the orchestrator logs.
set -u

mode="${STUB_CLAUDE_MODE:-commit}"
tid="${ICARIUM_TASK_ID:-unknown}"

# The reviewer invocation carries no ICARIUM_TASK_ID; in proof and tamper
# modes it records the prompt it was given (in the main repo's gitignored
# .icarium/, so it survives worktree teardown without dirtying the base
# checkout). All other invocations discard the prompt.
if [ "$mode" = priorattempt ] && [ -n "${ICARIUM_TASK_ID:-}" ]; then
    # Worker prompt: priorattempt reads the retry hand-off back out of it.
    common="$(git rev-parse --path-format=absolute --git-common-dir)"
    cat > "$common/../.icarium/stub-prior-prompt.txt"
elif { [ "$mode" = proof ] || [ "$mode" = tamper ] || [ "$mode" = launder ]; } && [ -z "${ICARIUM_TASK_ID:-}" ]; then
    common="$(git rev-parse --path-format=absolute --git-common-dir)"
    cat > "$common/../.icarium/stub-reviewer-prompt.txt"
else
    cat > /dev/null # consume the prompt
fi

init()   { echo '{"type":"system","subtype":"init"}'; }
result() { echo '{"type":"result","subtype":"success","is_error":false,"result":"stub done","num_turns":1}'; }

# Commit a task-unique file so the branch diverges from base.
commit_work() {
    echo "stub work for $tid" > "stub-$tid.txt"
    git add -A
    git commit -q -m "stub: task $tid"
}

case "$mode" in
    fail)
        init
        exit 2
        ;;
    dirty)
        init
        echo "left uncommitted" > "stub-dirty-$tid.txt"
        result
        exit 0
        ;;
    nocommit)
        init
        result
        exit 0
        ;;
    proof)
        if [ -n "${ICARIUM_TASK_ID:-}" ]; then
            # Worker: add a Proof section to the body FILE (the store agents
            # actually edit), then commit work so gates pass.
            init
            printf '\n## Proof\ngate output xproof1\n' >> "$(dirname "$ICARIUM_DB")/bodies/tasks/$tid.md"
            commit_work
            result
        else
            # Reviewer: prompt already captured above; no findings = pass.
            # printf %s: sh's echo would expand the escapes inside the JSON.
            init
            printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"{\"findings\":[]}","num_turns":1}'
        fi
        exit 0
        ;;
    tamper)
        if [ -n "${ICARIUM_TASK_ID:-}" ]; then
            # Worker: rewrite an existing body line (contract tampering, not
            # an appended Proof section), then commit work so gates pass.
            init
            body="$(dirname "$ICARIUM_DB")/bodies/tasks/$tid.md"
            sed 's/prove it/tampered xtamper1/' "$body" > "$body.tmp" && mv "$body.tmp" "$body"
            commit_work
            result
        else
            # Reviewer: prompt captured above; verdict pass.
            init
            printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"{\"findings\":[]}","num_turns":1}'
        fi
        exit 0
        ;;
    launder)
        # Retry-laundering regression: attempt 1 tampers and its reviewer
        # fails the attempt; attempt 2 changes nothing and its reviewer
        # passes. The prompt capture above overwrites per review, so the
        # recorded prompt is attempt 2's -- which must still report the
        # inherited tamper against the FIRST-attempt baseline.
        common="$(git rev-parse --path-format=absolute --git-common-dir)"
        count="$common/../.icarium/stub-launder-count"
        if [ -n "${ICARIUM_TASK_ID:-}" ]; then
            init
            if [ ! -f "$count" ]; then
                body="$(dirname "$ICARIUM_DB")/bodies/tasks/$tid.md"
                sed 's/prove it/tampered xlaunder1/' "$body" > "$body.tmp" && mv "$body.tmp" "$body"
                echo 1 > "$count"
            fi
            commit_work
            result
        else
            init
            if [ "$(cat "$count" 2>/dev/null)" = 1 ]; then
                echo 2 > "$count"
                printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"{\"findings\":[{\"axis\":\"spec\",\"severity\":\"fail\",\"message\":\"stub reviewer fails attempt 1\"}]}","num_turns":1}'
            else
                printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"{\"findings\":[]}","num_turns":1}'
            fi
        fi
        exit 0
        ;;
    priorattempt)
        # Retry hand-off: attempt 1 commits a file and its reviewer fails the
        # attempt; attempt 2 reads that commit back through the coordinates
        # its own prompt names, from inside its own fresh worktree.
        common="$(git rev-parse --path-format=absolute --git-common-dir)"
        count="$common/../.icarium/stub-prior-count"
        if [ -n "${ICARIUM_TASK_ID:-}" ]; then
            init
            if [ ! -f "$count" ]; then
                echo "prior work xprior1" > prior-work.txt
                echo 1 > "$count"
            else
                set -- $(sed -n 's/^Attempt .* at `\(.*\)`, cut from `\(.*\)`\./\1 \2/p' "$common/../.icarium/stub-prior-prompt.txt")
                {
                    printf 'sha=%s base=%s\n' "${1:-none}" "${2:-none}"
                    printf 'show=%s\n' "$(git show "${1:-none}:prior-work.txt" 2>&1)"
                    printf 'diff=%s\n' "$(git diff --name-only "${2:-none}" "${1:-none}" 2>&1 | tr '\n' ' ')"
                } > "$common/../.icarium/stub-prior-report.txt"
            fi
            commit_work
            result
        else
            init
            if [ "$(cat "$count" 2>/dev/null)" = 1 ]; then
                echo 2 > "$count"
                printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"{\"findings\":[{\"axis\":\"spec\",\"severity\":\"fail\",\"message\":\"stub reviewer fails attempt 1\"}]}","num_turns":1}'
            else
                printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"{\"findings\":[]}","num_turns":1}'
            fi
        fi
        exit 0
        ;;
    claimprobe)
        init
        # Record how the task looks WHILE the worker runs: the dispatcher
        # must have claimed it (in_progress + owner stamp) before this point.
        icarium task show "$tid" > "$(dirname "$ICARIUM_DB")/stub-claim-$tid.txt" 2>&1
        commit_work
        result
        exit 0
        ;;
    icarium)
        init
        # Nested-store regression: a child `icarium` with no --db must resolve
        # ICARIUM_DB (absolute) and hit the parent store, never create a nested
        # .icarium/icarium.db under the worktree cwd. Record the outcome next to
        # the parent DB (survives worktree teardown) for the test to read.
        icarium task list > /dev/null 2>&1
        rc=$?
        if [ -f .icarium/icarium.db ]; then nested=yes; else nested=no; fi
        printf 'rc=%s\nnested=%s\n' "$rc" "$nested" > "$(dirname "$ICARIUM_DB")/stub-report-$tid.txt"
        commit_work
        result
        exit 0
        ;;
    blocked)
        # Worker escalation: it stops inside policy and says why. No commits,
        # so the dispatch is a failure carrying the worker's own reason.
        init
        printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"{\"status\":\"blocked\",\"block_reason\":\"needs a decision from a human\",\"for_future_agents\":[]}","num_turns":1}'
        exit 0
        ;;
    commit | *)
        init
        commit_work
        result
        exit 0
        ;;
esac
