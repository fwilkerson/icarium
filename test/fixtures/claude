#!/bin/sh
# Stub `claude` for icarium's CLI integration tests.
#
# The dispatcher runs this with cwd = the dispatch worktree and with
# ICARIUM_TASK_ID / ICARIUM_DB set in the environment. Behaviour is chosen
# by STUB_CLAUDE_MODE (default: commit). We consume the prompt on stdin and
# emit the init + result stream-json lines the orchestrator logs.
set -u

mode="${STUB_CLAUDE_MODE:-commit}"
tid="${ICARIUM_TASK_ID:-unknown}"

# The reviewer invocation carries no ICARIUM_TASK_ID; in proof mode it
# records the prompt it was given (next to the main repo, so it survives
# worktree teardown). All other invocations discard the prompt.
if [ "$mode" = proof ] && [ -z "${ICARIUM_TASK_ID:-}" ]; then
    common="$(git rev-parse --path-format=absolute --git-common-dir)"
    cat > "$common/../stub-reviewer-prompt.txt"
else
    cat > /dev/null # consume the prompt
fi

init()   { echo '{"type":"system","subtype":"init"}'; }
result() { echo '{"type":"result","subtype":"success","is_error":false,"result":"stub done","num_turns":1}'; }

# Commit a task-unique file so the branch diverges from base.
commit_work() {
    echo "stub work for $tid" > "stub-$tid.txt"
    git add -A
    git commit -q -m "stub: task $tid"
}

case "$mode" in
    fail)
        init
        exit 2
        ;;
    dirty)
        init
        echo "left uncommitted" > "stub-dirty-$tid.txt"
        result
        exit 0
        ;;
    nocommit)
        init
        result
        exit 0
        ;;
    proof)
        if [ -n "${ICARIUM_TASK_ID:-}" ]; then
            # Worker: add a Proof section to the body FILE (the store agents
            # actually edit), then commit work so gates pass.
            init
            printf '\n## Proof\ngate output xproof1\n' >> "$(dirname "$ICARIUM_DB")/bodies/tasks/$tid.md"
            commit_work
            result
        else
            # Reviewer: prompt already captured above; verdict pass. The
            # verdict must sit in a fenced yaml block — bare status lines
            # are ignored by the anchored parser.
            # printf %s: sh's echo would expand the \n inside the JSON.
            init
            printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"```yaml\nstatus: pass\nfindings: []\n```","num_turns":1}'
        fi
        exit 0
        ;;
    icarium)
        init
        # Nested-store regression: a child `icarium` with no --db must resolve
        # ICARIUM_DB (absolute) and hit the parent store, never create a nested
        # .icarium/icarium.db under the worktree cwd. Record the outcome next to
        # the parent DB (survives worktree teardown) for the test to read.
        icarium task list > /dev/null 2>&1
        rc=$?
        if [ -f .icarium/icarium.db ]; then nested=yes; else nested=no; fi
        printf 'rc=%s\nnested=%s\n' "$rc" "$nested" > "$(dirname "$ICARIUM_DB")/stub-report-$tid.txt"
        commit_work
        result
        exit 0
        ;;
    commit | *)
        init
        commit_work
        result
        exit 0
        ;;
esac
